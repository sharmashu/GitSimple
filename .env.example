# =============================================================================
# GitSimple configuration. Copy to .env (Docker) or .env.local (npm run dev).
# =============================================================================

# ---- App ---------------------------------------------------------------------
# Public URL of this app (used for OAuth redirects behind proxies / Docker)
SITE_URL=http://localhost:3000
PORT=3000

# ---- Supabase (use your own project: https://supabase.com, or self-hosted) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- LLM (text generation): gemini | openai | anthropic -------------------------
# "openai" also works with any OpenAI-compatible API: Groq, OpenRouter, Together,
# DeepSeek, Mistral, Azure proxies, Ollama, LM Studio... (set LLM_BASE_URL)
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key
LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_JSON_MODE=true          # set false if your OpenAI-compatible server rejects response_format

# Examples:
#   OpenAI:     LLM_PROVIDER=openai    LLM_MODEL=gpt-4o-mini
#   Groq:       LLM_PROVIDER=openai    LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
#   OpenRouter: LLM_PROVIDER=openai    LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=<model id>
#   Anthropic:  LLM_PROVIDER=anthropic LLM_MODEL=claude-haiku-5-5
#   Ollama:     LLM_PROVIDER=openai    LLM_BASE_URL=http://host.docker.internal:11434/v1 LLM_MODEL=llama3.1  (no key needed)

# ---- Embeddings (RAG search): gemini | openai ---------------------------------
# Must produce 768-dimensional vectors (gemini-embedding-001, text-embedding-3-*, nomic-embed-text).
# Anthropic has no embedding API: if LLM_PROVIDER=anthropic, use gemini or openai here.
EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=          # defaults to LLM_API_KEY when the provider is the same
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- GitHub ------------------------------------------------------------------
# Optional but recommended: a token with NO scopes (fine-grained, public repos read-only).
# Raises the GitHub API limit for public repos from 60 to 5,000 requests/hour.
# It is never used to open private repos for other people.
GITHUB_TOKEN=
# Webhooks keep tracked repos up to date on every push.
# Public URL of /api/webhooks/github (for local dev use smee.io or ngrok).
WEBHOOK_PROXY_URL=https://your-app.example.com/api/webhooks/github
# Any long random string: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me

# ---- Limits (per minute / per day). Cached answers are free and unlimited -------
ANON_AI_PER_MINUTE=6
ANON_AI_PER_DAY=60
USER_AI_PER_MINUTE=20
USER_AI_PER_DAY=500
# Max characters of a diff sent to the model (lower = cheaper)
MAX_DIFF_CHARS=40000
